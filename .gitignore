cat > .gitignore <<'EOF'
# STM32 build files
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.o
*.d
*.lst

# IDE settings
.settings/
.project
.cproject
.vscode/
*.launch

# OS/system files
Thumbs.db
.DS_Store
EOF
.metadata/
# Ignore build output folders, but keep Makefiles
stm32_drivers/Debug/*
!stm32_drivers/Debug/Makefile

